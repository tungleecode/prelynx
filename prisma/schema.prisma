generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Lesson {
  id        String   @id
  type      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress  UserProgress[]
  essays    EssaySubmission[]

  @@index([type])
}

// NextAuth standard models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // USER, ADMIN
  
  // Plan & Stats
  targetBand    Float?
  currentBand   Float?
  examDate      DateTime?
  dailyGoal     Int?
  streak        Int       @default(0)
  gems          Int       @default(0)
  lastStudyDate DateTime?
  
  accounts      Account[]
  sessions      Session[]
  progress      UserProgress[]
  essays        EssaySubmission[]
  flashcards    FlashcardReview[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Specific Tracking Models
model UserProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  score     Float?
  answers   Json?
  isFav     Boolean  @default(false)
  lastSeen  DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model EssaySubmission {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  content     String   @db.Text
  wordCount   Int      @default(0)
  score       Float?
  feedback    Json?
  submittedAt DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model FlashcardReview {
  id          String   @id @default(cuid())
  userId      String
  word        String
  
  // SM-2 Algorithm fields
  interval    Int      @default(0) // Khoảng cách tới lần ôn tiếp (ngày)
  repetition  Int      @default(0) // Số lần ôn đúng liên tiếp
  efactor     Float    @default(2.5) // Ease factor
  dueDate     DateTime @default(now()) // Ngày đến hạn ôn tiếp
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
}
